@using Hoeyer.OpcUa.Client.Abstractions.Monitoring
@typeparam T
@inject EntityState<T> EntityState

<div>
    <h3>Current State:</h3>
    <ObjectViewer Item="State"/>
</div>

@code {
    private T? State;

    protected override void OnInitialized()
    {
        EntityState.OnStateChanged += HandleEntityStateChanged;
        State = EntityState.Current;
    }

    private void HandleEntityStateChanged(T newState)
    {
        State = newState;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        EntityState.OnStateChanged -= HandleEntityStateChanged;
    }

}